---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    id: 'boreholes',
    no: '01',
    title: 'Borehole Drilling & Water Works',
    intro: 'Clean, dependable water starts with the right hole in the right place. We handle the whole chain — locating, drilling, equipping and testing.',
    includes: ['Site survey & geophysical logging', 'Drilling & casing', 'Pump selection & installation', 'Water quality testing', 'Rehabilitation of failed boreholes', 'Maintenance contracts'],
  },
  {
    id: 'solar',
    no: '02',
    title: 'Solar Installations',
    intro: 'Grid power is unreliable and expensive. We size and install solar systems that keep homes, shops and farms running — and document every watt.',
    includes: ['Load assessment & system design', 'Panel & mounting installation', 'Inverters & battery banks', 'Solar water pumping for boreholes', 'System monitoring', 'Maintenance & fault response'],
  },
  {
    id: 'electrical',
    no: '03',
    title: 'Electrical Works',
    intro: 'Safe, code-compliant electrical installations for new buildings and upgrades — tested before handover and signed off properly.',
    includes: ['Complete wiring & rewiring', 'Distribution boards', 'Standby generators & changeovers', 'Lighting design & installation', 'Earthing & surge protection', 'Fault-finding & repairs'],
  },
  {
    id: 'plumbing',
    no: '04',
    title: 'Plumbing & Tank Structures',
    intro: 'Water supply and storage that works with gravity and pressure, sized for Kenyan rainfall and usage patterns.',
    includes: ['Water supply & distribution', 'Drainage & sewerage', 'Elevated & ground tank structures', 'Rainwater harvesting', 'Hot water systems', 'Leak detection & repair'],
  },
  {
    id: 'supplies',
    no: '05',
    title: 'General Supplies & Construction',
    intro: 'Supply of building materials and equipment, plus small works and construction support for homes and institutions.',
    includes: ['Building materials supply', 'Pumps, pipes & fittings', 'Fencing & farm works', 'Small civil works', 'Renovation support'],
  },
  {
    id: 'consultancy',
    no: '06',
    title: 'Engineering Consultancy',
    intro: 'Independent, practical advice before you commit: feasibility, costing, system design and supervision of works.',
    includes: ['Feasibility studies', 'System design & specification', 'Cost estimates', 'Contractor supervision', 'Inspection & reporting'],
  },
];

const process = [
  { no: 'A', title: 'Site visit', desc: 'We come to you, look at the ground, the load, the existing setup — and listen.' },
  { no: 'B', title: 'Proposal', desc: 'A written scope with clear pricing and a realistic timeline. No surprises later.' },
  { no: 'C', title: 'Works', desc: 'Our own teams do the job. You get progress updates, not silence.' },
  { no: 'D', title: 'Commissioning', desc: 'Tested in front of you, handed over with notes and warranty details.' },
];
---

<Layout title="Services — Essence Engineering, Kericho">
  <Header />

  <!-- Page head -->
  <section class="pagehead blueprint" style="border-bottom:1px solid var(--line)">
    <div class="wrap" style="padding-block:clamp(4rem,9vw,6rem)">
      <p class="kicker mono-label mono-label--blue rise" style="--d:.05s">Service index — 06 lines</p>
      <h1 class="display rise" style="--d:.12s">What we <span class="strong-blue">build.</span></h1>
      <p class="lead rise" style="--d:.2s;margin-top:1.5rem">
        Water, power and infrastructure services for homes, farms, institutions and businesses across the South Rift and beyond.
      </p>
    </div>
  </section>

  <!-- Service blocks -->
  <section class="section">
    <div class="wrap">
      {services.map((s, i) => (
        <article class="svc" id={s.id} data-reveal>
          <header class="svc__head">
            <span class="svc__no mono-label mono-label--blue tabular">{s.no}</span>
            <h2 class="h2">{s.title}</h2>
          </header>
          <div class="svc__body">
            <p class="svc__intro">{s.intro}</p>
            <ul class="svc__list">
              {s.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="svc__cta">
              <a href="/contact" class="btn btn-blue">Request a quote <span class="btn-arrow">→</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="background:var(--surface);border-block:1px solid var(--line)" data-reveal>
    <div class="wrap">
      <p class="kicker mono-label">How we work</p>
      <h2 class="h2" style="margin-bottom:clamp(2.5rem,6vw,4rem)">Four steps, <span class="strong-blue">no theatre.</span></h2>
      <div class="proc-grid">
        {process.map((p) => (
          <div class="proc">
            <span class="proc__no mono-label mono-label--blue tabular">{p.no}</span>
            <h3 class="h3" style="margin:.75rem 0 .5rem">{p.title}</h3>
            <p style="color:var(--ink-2);font-size:.9375rem;margin:0">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" style="background:var(--dark);color:var(--on-dark)">
    <div class="wrap cta-inner">
      <div>
        <p class="mono-label mono-label--dark" style="margin-bottom:1.25rem">Not sure what you need?</p>
        <h2 class="h2" style="color:var(--on-dark)">Describe the problem.<br />We'll tell you the honest fix.</h2>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-darkband">Talk to us <span class="btn-arrow">→</span></a>
        <a href="tel:+254700000000" class="btn cta-tel">+254 700 000 000</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ---- service blocks: spec-sheet sections, not cards ---- */
  .svc {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    gap: 1.5rem;
  }

  .svc:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .svc__head {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .svc__no {
    flex-shrink: 0;
  }

  .svc__body {
    display: grid;
    gap: 1.5rem;
  }

  .svc__intro {
    color: var(--ink-2);
    font-size: 1.0625rem;
    margin: 0;
    max-width: 60ch;
  }

  .svc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .svc__list li {
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .svc__cta {
    padding-top: 0.5rem;
  }

  @media (min-width: 860px) {
    .svc__head {
      grid-column: 1;
    }
    .svc__body {
      grid-template-columns: 1.2fr 1fr;
    }
    .svc__cta {
      grid-column: 1 / -1;
    }
    .svc__list li:nth-child(odd) {
      padding-right: 1.5rem;
    }
    .svc__list li:nth-child(even) {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
  }

  /* ---- process ---- */
  .proc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .proc {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  @media (min-width: 700px) {
    .proc-grid { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  }

  /* ---- cta ---- */
  .cta-inner {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .cta-tel {
    border-color: var(--on-dark-line);
    color: var(--on-dark);
    background: transparent;
  }

  .cta-tel:hover {
    border-color: var(--on-dark);
  }

  @media (min-width: 860px) {
    .cta-inner {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
    }
    .cta-actions {
      justify-content: flex-end;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
