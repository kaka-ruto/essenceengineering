---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.727-3.571" /></svg>`,
    title: 'Borehole Services',
    description: 'Complete borehole solutions from site survey to drilling, equipping, and ongoing maintenance. We handle residential, commercial, and agricultural projects.',
    features: ['Site Survey & Geophysical Logging', 'Borehole Drilling (Up to 300m+)', 'Borehole Equipping & Pump Installation', 'Water Quality Testing', 'Borehole Rehabilitation', 'Annual Maintenance Contracts'],
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>`,
    title: 'Electrical Works',
    description: 'Professional electrical services for homes, businesses, and industrial facilities. Licensed electricians delivering safe, code-compliant installations.',
    features: ['Complete Wiring & Rewiring', 'Distribution Board Installation', 'Generator Installation & Servicing', 'Lighting Design & Installation', 'Electrical Maintenance & Repairs', 'Earthing & Surge Protection'],
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
    title: 'Plumbing Works',
    description: 'Expert plumbing solutions for residential and commercial properties. From new installations to emergency repairs, we handle it all.',
    features: ['Water Supply Systems', 'Drainage & Sewerage Systems', 'Hot Water System Installation', 'Leak Detection & Repair', 'Bathroom & Kitchen Fitting', 'Septic Tank Installation'],
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21" /></svg>`,
    title: 'Tank Structures',
    description: 'Design and construction of water storage solutions including elevated tanks, ground-level tanks, and custom structures.',
    features: ['Elevated Tank Construction', 'Ground-Level Tank Installation', 'Steel & Concrete Structures', 'Tank Maintenance & Repair', 'Water Treatment Systems', 'Rainwater Harvesting'],
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>`,
    title: 'Solar Installations',
    description: 'Complete solar energy solutions to reduce your electricity costs. We design, install, and maintain solar power systems.',
    features: ['Solar Panel Installation', 'Inverter System Setup', 'Battery Backup Systems', 'Solar Water Heating', 'Solar Street Lighting', 'System Monitoring & Maintenance'],
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>`,
    title: 'General Consultancy',
    description: 'Expert engineering consultancy for construction, networking, and infrastructure projects. From concept to completion.',
    features: ['Project Planning & Design', 'Construction Management', 'Network Infrastructure', 'Building Consultancy', 'Feasibility Studies', 'Cost Estimation & Budgeting'],
  },
];
---

<Layout title="Our Services | Essence Engineering">
  <Header />

  <!-- Hero -->
  <section class="pt-32 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-dark)] via-[var(--color-primary-dark)] to-[var(--color-darker)]"></div>
    <div class="absolute top-20 right-10 w-72 h-72 bg-[var(--color-secondary)] rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-pulse-glow"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">Our <span class="gradient-text">Services</span></h1>
      <p class="text-xl text-[var(--color-text-muted)] max-w-2xl">
        Comprehensive engineering solutions delivered with expertise, precision, and commitment to excellence.
      </p>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 space-y-16">
      {services.map((service, i) => (
        <div class={`glass-card p-8 md:p-12 grid lg:grid-cols-2 gap-12 items-center ${i % 2 === 1 ? 'lg:direction-rtl' : ''}`}>
          <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
            <div class="w-16 h-16 rounded-xl bg-[var(--color-secondary)]/10 flex items-center justify-center text-[var(--color-secondary)] mb-6" set:html={service.icon}></div>
            <h2 class="text-3xl font-bold mb-4">{service.title}</h2>
            <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-6">{service.description}</p>
            <a href="/contact" class="btn-primary">
              Get a Quote
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
          <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
            <div class="space-y-4">
              {service.features.map((feature) => (
                <div class="flex items-center gap-4 p-4 rounded-lg bg-[var(--color-surface)]/50">
                  <div class="w-8 h-8 rounded-full bg-[var(--color-accent)]/20 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-[var(--color-accent)]"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  </div>
                  <span class="text-[var(--color-text)]">{feature}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="py-24 bg-[var(--color-dark)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Our <span class="gradient-text">Process</span></h2>
        <p class="text-xl text-[var(--color-text-muted)]">How we deliver excellence in every project.</p>
      </div>
      <div class="grid md:grid-cols-4 gap-8">
        {[
          { step: '01', title: 'Consultation', desc: 'We discuss your needs and conduct an initial assessment.' },
          { step: '02', title: 'Planning', desc: 'Detailed project planning with timelines and cost estimates.' },
          { step: '03', title: 'Execution', desc: 'Professional implementation by our skilled team.' },
          { step: '04', title: 'Handover', desc: 'Quality inspection, documentation, and warranty coverage.' },
        ].map((item) => (
          <div class="text-center">
            <div class="text-5xl font-bold gradient-text mb-4">{item.step}</div>
            <h3 class="text-xl font-bold mb-2">{item.title}</h3>
            <p class="text-[var(--color-text-muted)]">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] opacity-90"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">Need Engineering Solutions?</h2>
      <p class="text-xl text-white/80 mb-8">Contact us for a free consultation and quote.</p>
      <a href="/contact" class="btn-primary bg-white text-[var(--color-primary)] hover:bg-white/90">
        Get Free Quote
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
