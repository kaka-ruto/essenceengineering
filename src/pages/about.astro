---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const values = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>`,
    title: 'Excellence',
    description: 'We strive for the highest quality in every project we undertake.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
    title: 'Integrity',
    description: 'Transparent, honest, and ethical in all our dealings.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>`,
    title: 'Teamwork',
    description: 'Collaboration and mutual respect drive our success.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`,
    title: 'Innovation',
    description: 'Embracing modern solutions and technologies for better outcomes.',
  },
];

const milestones = [
  { year: '2015', event: 'Company Founded', description: 'Essence Engineering established by Kevin Terer in Kericho.' },
  { year: '2017', event: 'First Major Project', description: 'Completed large-scale borehole project for Kericho County.' },
  { year: '2019', event: 'Solar Division', description: 'Expanded into solar energy installations.' },
  { year: '2022', event: 'Regional Expansion', description: 'Extended operations to Nakuru, Eldoret, and Nairobi.' },
  { year: '2026', event: 'Registration', description: 'Officially registered as Essence Engineering Limited.' },
];
---

<Layout title="About Us | Essence Engineering">
  <Header />

  <!-- Hero -->
  <section class="pt-32 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-dark)] via-[var(--color-primary-dark)] to-[var(--color-darker)]"></div>
    <div class="absolute top-20 left-10 w-96 h-96 bg-[var(--color-accent)] rounded-full mix-blend-multiply filter blur-[128px] opacity-10 animate-pulse-glow"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">About <span class="gradient-text">Essence Engineering</span></h1>
      <p class="text-xl text-[var(--color-text-muted)] max-w-2xl">
        Powering life and delivering excellence across Kenya since 2015.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-4xl font-bold mb-6">Our <span class="gradient-text">Story</span></h2>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-6">
          Essence Engineering Limited was founded with a vision to provide reliable, high-quality engineering services to communities and businesses across Kenya. Starting in Kericho, we have grown to serve clients throughout the country.
        </p>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-6">
          Our founder, Kevin Terer, recognized the need for dependable engineering solutions in water, electrical, and construction services. Today, we are a trusted partner for hundreds of clients, from homeowners to large enterprises.
        </p>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed">
          We are registered as Essence Engineering Limited, specializing in general supplies, consultancy, construction, building, networking, electrical, and water works.
        </p>
      </div>
      <div class="glass-card p-8">
        <div class="grid grid-cols-2 gap-6">
          <div class="text-center p-6 rounded-xl bg-[var(--color-surface)]">
            <div class="text-4xl font-bold gradient-text mb-2">500+</div>
            <div class="text-[var(--color-text-muted)] text-sm">Projects Completed</div>
          </div>
          <div class="text-center p-6 rounded-xl bg-[var(--color-surface)]">
            <div class="text-4xl font-bold gradient-text mb-2">10+</div>
            <div class="text-[var(--color-text-muted)] text-sm">Years Experience</div>
          </div>
          <div class="text-center p-6 rounded-xl bg-[var(--color-surface)]">
            <div class="text-4xl font-bold gradient-text mb-2">50+</div>
            <div class="text-[var(--color-text-muted)] text-sm">Team Members</div>
          </div>
          <div class="text-center p-6 rounded-xl bg-[var(--color-surface)]">
            <div class="text-4xl font-bold gradient-text mb-2">100%</div>
            <div class="text-[var(--color-text-muted)] text-sm">Client Satisfaction</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-24 bg-[var(--color-dark)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Our <span class="gradient-text">Values</span></h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((value) => (
          <div class="glass-card p-8 text-center">
            <div class="w-16 h-16 rounded-xl bg-[var(--color-secondary)]/10 flex items-center justify-center text-[var(--color-secondary)] mx-auto mb-6" set:html={value.icon}></div>
            <h3 class="text-xl font-bold mb-3">{value.title}</h3>
            <p class="text-[var(--color-text-muted)]">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Our <span class="gradient-text">Journey</span></h2>
      </div>
      <div class="space-y-8">
        {milestones.map((m) => (
          <div class="glass-card p-6 flex gap-6 items-start">
            <div class="text-2xl font-bold gradient-text whitespace-nowrap">{m.year}</div>
            <div>
              <h3 class="text-lg font-bold mb-1">{m.event}</h3>
              <p class="text-[var(--color-text-muted)]">{m.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="py-24 bg-[var(--color-dark)]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="glass-card p-12">
        <div class="w-32 h-32 rounded-full bg-gradient-to-br from-[var(--color-secondary)] to-[var(--color-accent)] mx-auto mb-6 flex items-center justify-center text-4xl font-bold text-white">KT</div>
        <h2 class="text-3xl font-bold mb-2">Kevin Terer</h2>
        <p class="text-[var(--color-secondary)] text-lg mb-6">Founder & Managing Director</p>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed max-w-2xl mx-auto">
          "Our mission is to deliver engineering solutions that empower communities and businesses. We believe in quality, reliability, and building lasting relationships with our clients."
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
