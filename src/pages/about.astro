---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About — Essence Engineering">
  <Header />

  <!-- Page head -->
  <section class="pagehead blueprint" style="border-bottom:1px solid var(--line)">
    <div class="wrap" style="padding-block:clamp(4rem,9vw,6rem)">
      <p class="kicker mono-label mono-label--blue rise" style="--d:.05s">About the company</p>
      <h1 class="display rise" style="--d:.12s">A company that finishes<br />what it <span class="strong-blue">starts.</span></h1>
    </div>
  </section>

  <!-- Story -->
  <section class="section">
    <div class="wrap about-grid">
      <div>
        <p class="kicker mono-label">Who we are</p>
        <h2 class="h2" style="margin-bottom:1.5rem">A Kenyan engineering company.</h2>
      </div>
      <div class="prose" style="display:grid;gap:1.25rem">
        <p>
          Essence Engineering Limited is a registered Kenyan company. We drill boreholes, install solar and electrical systems, build water storage and plumbing, supply materials, and consult on engineering works.
        </p>
        <p>
          The company was founded by Kevin Terer, and is run on a simple principle: the client should never have to chase the contractor. We survey before we quote, build to standard, and stay on the line after handover.
        </p>
        <p>
          Our work is for homes, farms, schools, churches and businesses — anyone who needs water or power they can rely on.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" style="background:var(--dark);color:var(--on-dark)">
    <div class="wrap cta-inner">
      <div>
        <p class="mono-label mono-label--dark" style="margin-bottom:1.25rem">Next step</p>
        <h2 class="h2" style="color:var(--on-dark)">Need water or power work done?<br />Call us and we'll take it from there.</h2>
      </div>
      <div class="cta-actions">
        <a href="tel:254799240047" class="btn btn-darkband">Call +254 799 240 047</a>
        <a href="/contact" class="btn cta-tel">Email or WhatsApp</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .about-grid {
    display: grid;
    gap: 2rem;
  }

  .cta-inner {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }

  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.875rem; }
  .cta-tel {
    border-color: var(--on-dark-line);
    color: var(--on-dark);
    background: transparent;
  }
  .cta-tel:hover { border-color: var(--on-dark); }

  @media (min-width: 700px) {
    .about-grid { grid-template-columns: 1fr 1.6fr; gap: 4rem; }
  }

  @media (min-width: 860px) {
    .cta-inner { grid-template-columns: 1.5fr 1fr; align-items: center; }
    .cta-actions { justify-content: flex-end; flex-direction: column; align-items: flex-start; }
  }
</style>
