---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    title: 'Kericho Water Supply Project',
    category: 'Borehole Services',
    location: 'Kericho',
    description: 'Complete borehole drilling and equipping for a residential estate serving 200+ households. Included pump installation, water treatment, and distribution system.',
    image: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&h=400&fit=crop',
    year: '2024',
  },
  {
    title: 'Nakuru Solar Installation',
    category: 'Solar Installations',
    location: 'Nakuru',
    description: '50kW solar system installation for a commercial complex, reducing energy costs by 60%. Includes battery backup for critical operations.',
    image: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?w=600&h=400&fit=crop',
    year: '2024',
  },
  {
    title: 'Eldoret Electrical Works',
    category: 'Electrical Works',
    location: 'Eldoret',
    description: 'Full electrical installation for a 5-story commercial building including backup generators, lighting design, and smart controls.',
    image: 'https://images.unsplash.com/photo-1621905252507-b35492cc74b4?w=600&h=400&fit=crop',
    year: '2023',
  },
  {
    title: 'Kericho Heights Tank Structure',
    category: 'Tank Structures',
    location: 'Kericho',
    description: 'Construction of elevated water tank structure for a residential development. 50,000-liter capacity steel tank on reinforced concrete tower.',
    image: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&h=400&fit=crop',
    year: '2023',
  },
  {
    title: 'Bomet Farm Plumbing',
    category: 'Plumbing Works',
    location: 'Bomet',
    description: 'Complete plumbing system for a 200-acre agricultural farm including irrigation, water supply, and drainage systems.',
    image: 'https://images.unsplash.com/photo-1585704032915-c3400ca199e7?w=600&h=400&fit=crop',
    year: '2023',
  },
  {
    title: 'Nairobi Office Complex',
    category: 'General Consultancy',
    location: 'Nairobi',
    description: 'Engineering consultancy for a 10-story office complex. Included structural assessment, MEP design, and project management.',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=600&h=400&fit=crop',
    year: '2024',
  },
];

const categories = ['All', 'Borehole Services', 'Electrical Works', 'Plumbing Works', 'Tank Structures', 'Solar Installations', 'General Consultancy'];
---

<Layout title="Our Projects | Essence Engineering">
  <Header />

  <!-- Hero -->
  <section class="pt-32 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-dark)] via-[var(--color-primary-dark)] to-[var(--color-darker)]"></div>
    <div class="absolute top-20 left-10 w-72 h-72 bg-[var(--color-accent)] rounded-full mix-blend-multiply filter blur-[128px] opacity-10 animate-pulse-glow"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">Our <span class="gradient-text">Projects</span></h1>
      <p class="text-xl text-[var(--color-text-muted)] max-w-2xl">
        A showcase of our engineering projects across Kenya.
      </p>
    </div>
  </section>

  <!-- Filter -->
  <section class="py-8 border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-wrap gap-3" id="filters">
        {categories.map((cat, i) => (
          <button class={`px-4 py-2 rounded-full text-sm font-medium transition-all ${i === 0 ? 'bg-[var(--color-secondary)] text-white' : 'bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-white hover:bg-[var(--color-surface-light)]'}`} data-filter={cat === 'All' ? 'all' : cat}>
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
        {projects.map((project) => (
          <div class="glass-card overflow-hidden group cursor-pointer project-card" data-category={project.category}>
            <div class="relative h-56 overflow-hidden">
              <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-dark)] to-transparent"></div>
              <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-[var(--color-secondary)]/90 text-sm font-medium">{project.category}</div>
              <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-[var(--color-dark)]/80 text-sm text-[var(--color-text-muted)]">{project.year}</div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                {project.location}
              </div>
              <h3 class="text-xl font-bold mb-2">{project.title}</h3>
              <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{project.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-[var(--color-dark)]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">Start Your <span class="gradient-text">Project</span></h2>
      <p class="text-xl text-[var(--color-text-muted)] mb-8">Ready to work with us? Let's discuss your engineering needs.</p>
      <a href="/contact" class="btn-primary">
        Get a Free Quote
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll('#filters button');
    const cards = document.querySelectorAll('.project-card');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        filters.forEach(b => {
          b.classList.remove('bg-[var(--color-secondary)]', 'text-white');
          b.classList.add('bg-[var(--color-surface)]', 'text-[var(--color-text-muted)]');
        });
        btn.classList.add('bg-[var(--color-secondary)]', 'text-white');
        btn.classList.remove('bg-[var(--color-surface)]', 'text-[var(--color-text-muted)]');

        const filter = btn.getAttribute('data-filter');
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
