---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projects = [
  { no: 'P.01', cat: 'Water works', title: 'Borehole supply for a residential estate', loc: 'Kericho', desc: 'Site survey, drilling to 140 m, pump installation and water quality testing — 200+ households supplied.', img: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1000&q=70&auto=format&fit=crop', year: '2025' },
  { no: 'P.02', cat: 'Solar', title: '50 kW commercial solar system', loc: 'Nakuru', desc: 'Roof-mounted array, inverter room and battery backup sized to cut grid dependence for a trading complex.', img: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1000&q=70&auto=format&fit=crop', year: '2025' },
  { no: 'P.03', cat: 'Electrical', title: 'Full electrical fit-out, commercial building', loc: 'Eldoret', desc: 'Wiring, distribution, earthing and generator changeover for a five-storey building.', img: 'https://images.unsplash.com/photo-1621905252507-b35492cc74b4?w=1000&q=70&auto=format&fit=crop', year: '2024' },
  { no: 'P.04', cat: 'Tanks & plumbing', title: 'Elevated tank & supply upgrade', loc: 'Kericho', desc: 'Steel tank on a reinforced stand, booster set and full distribution rework for an institution.', img: 'https://images.unsplash.com/photo-1585704032915-c3400ca199e7?w=1000&q=70&auto=format&fit=crop', year: '2024' },
  { no: 'P.05', cat: 'Solar pumping', title: 'Solar water pump for a tea farm', loc: 'Bomet', desc: 'Submersible pump running off solar alone — no grid, no diesel, year-round water for the nursery.', img: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1000&q=70&auto=format&fit=crop', year: '2024' },
  { no: 'P.06', cat: 'Consultancy', title: 'Water master-plan for a school', loc: 'Kericho County', desc: 'Feasibility, borehole siting, storage sizing and phased budget for a boarding school.', img: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1000&q=70&auto=format&fit=crop', year: '2023' },
];

const cats = ['All', 'Water works', 'Solar', 'Electrical', 'Tanks & plumbing', 'Consultancy'];
---

<Layout title="Selected Projects — Essence Engineering">
  <Header />

  <!-- Page head -->
  <section class="pagehead blueprint" style="border-bottom:1px solid var(--line)">
    <div class="wrap" style="padding-block:clamp(4rem,9vw,6rem)">
      <p class="kicker mono-label mono-label--blue rise" style="--d:.05s">Project register</p>
      <h1 class="display rise" style="--d:.12s">Selected <span class="strong-blue">works.</span></h1>
      <p class="lead rise" style="--d:.2s;margin-top:1.5rem">
        A running record of boreholes, solar systems and electrical works we have delivered.
      </p>
    </div>
  </section>

  <!-- Filter bar -->
  <section style="border-bottom:1px solid var(--line);background:var(--surface)">
    <div class="wrap filterbar" id="filters">
      {cats.map((c, i) => (
        <button
          class={`chip press${i === 0 ? ' chip--on' : ''}`}
          data-filter={c === 'All' ? 'all' : c}
        >
          {c}
        </button>
      ))}
    </div>
  </section>

  <!-- Register -->
  <section class="section">
    <div class="wrap">
      <div class="reg" id="reg">
        {projects.map((p, i) => (
          <article class="reg-row" data-cat={p.cat} data-reveal style={`--rd:${(i % 3) * 70}ms`}>
            <div class="frame zoom-frame reg-frame">
              <img src={p.img} alt={p.title} width="1000" height="660" loading="lazy" />
            </div>
            <div class="reg-info">
              <p class="mono-label tabular" style="display:flex;justify-content:space-between;gap:1rem;margin-bottom:1rem">
                <span class="strong-blue">{p.no} — {p.cat}</span>
                <span>{p.year}</span>
              </p>
              <h2 class="h3" style="margin-bottom:.5rem">{p.title}</h2>
              <p style="color:var(--ink-2);font-size:.9375rem;margin-bottom:1rem">{p.desc}</p>
              <p class="mono-label" style="margin:0">
                <span style="color:var(--ink-3)">Loc.</span> {p.loc}
              </p>
            </div>
          </article>
        ))}
      </div>

      <p class="mono-label" style="margin-top:3rem">
        Full case references available on request. <a href="/contact" class="link-line">Ask us →</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.5rem 0.875rem;
    border-radius: 3px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }

  .chip:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .chip--on {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }

  .reg-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 3rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
    align-items: center;
  }

  .reg-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .reg-frame {
    aspect-ratio: 16 / 10;
    display: block;
    overflow: hidden;
  }

  @media (min-width: 860px) {
    .reg-row {
      grid-template-columns: 1.1fr 1fr;
    }
    .reg-row:nth-child(even) .reg-frame {
      order: 2;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chips = document.querySelectorAll('#filters .chip');
    const rows = document.querySelectorAll('#reg .reg-row');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('chip--on'));
        chip.classList.add('chip--on');
        const f = chip.getAttribute('data-filter');
        rows.forEach((row) => {
          const on = f === 'all' || row.getAttribute('data-cat') === f;
          row.style.display = on ? '' : 'none';
        });
      });
    });
  });
</script>
