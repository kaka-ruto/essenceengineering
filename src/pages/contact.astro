---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contactRows = [
  { label: 'Office', value: 'Kericho Town, along the Kericho–Nakuru road' },
  { label: 'Call', value: '+254 700 000 000', href: 'tel:+254700000000' },
  { label: 'WhatsApp', value: '+254 700 000 000', href: 'https://wa.me/254700000000' },
  { label: 'Email', value: 'info@essenceengineering.co.ke', href: 'mailto:info@essenceengineering.co.ke' },
  { label: 'Hours', value: 'Mon–Fri 8:00–17:00 · Sat 8:00–12:00 · Emergencies 24/7' },
];
---

<Layout title="Contact — Essence Engineering, Kericho">
  <Header />

  <!-- Page head -->
  <section class="pagehead blueprint" style="border-bottom:1px solid var(--line)">
    <div class="wrap" style="padding-block:clamp(4rem,9vw,6rem)">
      <p class="kicker mono-label mono-label--blue rise" style="--d:.05s">Contact — free site visit</p>
      <h1 class="display rise" style="--d:.12s">Talk to a person,<br /><span class="strong-blue">not a call centre.</span></h1>
      <p class="lead rise" style="--d:.2s;margin-top:1.5rem">
        Describe the job in the form or call directly. We reply during working hours, usually the same day.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact-grid">
      <!-- Details -->
      <div>
        <div class="crows">
          {contactRows.map((r) => (
            <div class="crow">
              <span class="mono-label mono-label--blue crow-label">{r.label}</span>
              {r.href ? (
                <a href={r.href} class="crow-value link-line">{r.value}</a>
              ) : (
                <span class="crow-value">{r.value}</span>
              )}
            </div>
          ))}
        </div>

        <!-- Location block -->
        <div class="loc" data-reveal>
          <p class="mono-label mono-label--blue" style="margin-bottom:1.25rem">Position — head office</p>
          <p class="loc-coords tabular">0°22′S&nbsp;&nbsp;35°17′E</p>
          <p class="mono-label" style="margin-top:1rem">Kericho Town, Kenya</p>
        </div>
      </div>

      <!-- Form -->
      <div class="form-panel">
        <form action="https://formsubmit.co/info@essenceengineering.co.ke" method="POST" data-reveal>
          <input type="hidden" name="_subject" value="New enquiry — essenceengineering website" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" aria-hidden="true" tabindex="-1" />

          <div class="form-grid">
            <div class="field">
              <label for="f-name">Full name *</label>
              <input id="f-name" type="text" name="name" required autocomplete="name" placeholder="e.g. Jane Wanjiku" />
            </div>
            <div class="field">
              <label for="f-tel">Phone *</label>
              <input id="f-tel" type="tel" name="phone" required autocomplete="tel" inputmode="tel" placeholder="+254 7XX XXX XXX" />
            </div>
          </div>
          <div class="field">
            <label for="f-service">What do you need? *</label>
            <select id="f-service" name="service" required>
              <option value="">Select a service…</option>
              <option>Borehole drilling / water works</option>
              <option>Solar installation</option>
              <option>Electrical works</option>
              <option>Plumbing / tank structures</option>
              <option>General supplies / construction</option>
              <option>Consultancy / feasibility</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="f-loc">Site location</label>
            <input id="f-loc" type="text" name="location" placeholder="Town / village / landmark" />
          </div>
          <div class="field">
            <label for="f-msg">Tell us about the job *</label>
            <textarea id="f-msg" name="message" required placeholder="What is the situation? Any existing systems? When do you need it done?"></textarea>
          </div>
          <button type="submit" class="btn btn-blue" style="width:100%">
            Send enquiry
            <span class="btn-arrow">→</span>
          </button>
          <p class="mono-label" style="margin:1rem 0 0;text-align:center">We reply during working hours — usually the same day.</p>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 3.5rem;
  }

  /* contact rows */
  .crows {
    border-top: 1px solid var(--line);
  }

  .crow {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) 1fr;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .crow-value {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  /* location block */
  .loc {
    margin-top: 3rem;
    border: 1px solid var(--line-2);
    background:
      linear-gradient(to right, rgba(15, 31, 49, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 31, 49, 0.04) 1px, transparent 1px),
      var(--surface);
    background-size: 28px 28px;
    padding: 2rem;
    position: relative;
  }

  .loc::before,
  .loc::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
  }

  .loc::before { top: -1px; left: -1px; border-top: 2px solid var(--blue); border-left: 2px solid var(--blue); }
  .loc::after { bottom: -1px; right: -1px; border-bottom: 2px solid var(--blue); border-right: 2px solid var(--blue); }

  .loc-coords {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* form panel */
  .form-panel {
    background: var(--surface);
    border: 1px solid var(--line-2);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.25rem;
  }

  @media (min-width: 700px) {
    .form-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
  }
</style>
