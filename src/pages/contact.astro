---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contactRows = [
  { label: 'Office', value: 'Kericho Town, Kenya', href: null },
  { label: 'Call', value: '+254 799 240 047', href: 'tel:254799240047' },
  { label: 'WhatsApp', value: '+254 799 240 047', href: 'https://wa.me/254799240047' },
  { label: 'Email', value: 'tessenceng@gmail.com', href: 'mailto:tessenceng@gmail.com' },
  { label: 'Hours', value: 'Mon–Fri 8:00–17:00 · Sat 8:00–12:00 · Emergencies 24/7' },
];
---

<Layout title="Contact — Essence Engineering">
  <Header />

  <!-- Page head -->
  <section class="pagehead blueprint" style="border-bottom:1px solid var(--line)">
    <div class="wrap" style="padding-block:clamp(4rem,9vw,6rem)">
      <p class="kicker mono-label mono-label--blue rise" style="--d:.05s">Contact — free site visit</p>
      <h1 class="display rise" style="--d:.12s">Talk to a person,<br /><span class="strong-blue">not a call centre.</span></h1>
      <p class="lead rise" style="--d:.2s;margin-top:1.5rem">
        Call or email us directly. We reply during working hours, usually the same day.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact-grid">
      <!-- Details -->
      <div>
        <div class="crows">
          {contactRows.map((r) => (
            <div class="crow">
              <span class="mono-label mono-label--blue crow-label">{r.label}</span>
              {r.href ? (
                <a href={r.href} class="crow-value link-line">{r.value}</a>
              ) : (
                <span class="crow-value">{r.value}</span>
              )}
            </div>
          ))}
        </div>

        <!-- Location block -->
        <div class="loc" data-reveal>
          <p class="mono-label mono-label--blue" style="margin-bottom:1.25rem">Head office — position</p>
          <p class="loc-coords tabular">0°22′S&nbsp;&nbsp;35°17′E</p>
        </div>
      </div>

      <!-- Direct actions (no form) -->
      <div class="direct-panel" data-reveal>
        <p class="mono-label mono-label--blue" style="margin-bottom:2rem">Reach us directly</p>

        <a href="tel:254799240047" class="direct-row press">
          <span class="direct-row__label mono-label">Call — phone</span>
          <span class="direct-row__value">+254 799 240 047</span>
          <span class="direct-row__arrow mono-label">→</span>
        </a>

        <a href="mailto:tessenceng@gmail.com" class="direct-row press">
          <span class="direct-row__label mono-label">Email</span>
          <span class="direct-row__value">tessenceng@gmail.com</span>
          <span class="direct-row__arrow mono-label">→</span>
        </a>

        <a href="https://wa.me/254799240047" class="direct-row press">
          <span class="direct-row__label mono-label">WhatsApp</span>
          <span class="direct-row__value">+254 799 240 047</span>
          <span class="direct-row__arrow mono-label">→</span>
        </a>

        <p class="mono-label" style="margin-top:2rem">
          Tell us the location, the situation, and when you need it done. We come to you for the site visit.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 3.5rem;
  }

  /* contact rows */
  .crows {
    border-top: 1px solid var(--line);
  }

  .crow {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) 1fr;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .crow-value {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  /* location block */
  .loc {
    margin-top: 3rem;
    border: 1px solid var(--line-2);
    background:
      linear-gradient(to right, rgba(15, 31, 49, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 31, 49, 0.04) 1px, transparent 1px),
      var(--surface);
    background-size: 28px 28px;
    padding: 2rem;
    position: relative;
  }

  .loc::before,
  .loc::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
  }

  .loc::before { top: -1px; left: -1px; border-top: 2px solid var(--blue); border-left: 2px solid var(--blue); }
  .loc::after { bottom: -1px; right: -1px; border-bottom: 2px solid var(--blue); border-right: 2px solid var(--blue); }

  .loc-coords {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* direct contact rows */
  .direct-panel {
    background: var(--surface);
    border: 1px solid var(--line-2);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    align-self: start;
  }

  .direct-row {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.375rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
    transition: background-color var(--t-med) var(--ease-out);
  }

  .direct-row:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .direct-row__value {
    font-weight: 800;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .direct-row__arrow {
    transition: transform var(--t-med) var(--ease-out);
  }

  @media (any-hover: hover) {
    .direct-row:hover {
      background: var(--blue-tint);
    }
    .direct-row:hover .direct-row__arrow {
      transform: translateX(4px);
    }
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
  }
</style>
