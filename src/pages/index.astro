---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.727-3.571" /></svg>`,
    title: 'Borehole Services',
    description: 'Complete borehole drilling, equipping, and maintenance. We provide reliable water solutions for homes, farms, and commercial properties across Kenya.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>`,
    title: 'Electrical Works',
    description: 'Professional electrical installations, wiring, and maintenance for residential, commercial, and industrial properties. Licensed and certified electricians.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
    title: 'Plumbing Works',
    description: 'Expert plumbing services including installation, repair, and maintenance of water systems, drainage, and sewage infrastructure.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21" /></svg>`,
    title: 'Tank Structures',
    description: 'Design and construction of water tanks, elevated tank structures, and water storage solutions for residential and commercial use.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>`,
    title: 'Solar Installations',
    description: 'Complete solar energy solutions including panel installation, inverter systems, and battery storage for homes and businesses.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>`,
    title: 'General Consultancy',
    description: 'Expert engineering consultancy for construction, building, networking, and infrastructure projects. From planning to execution.',
  },
];

const stats = [
  { value: '500+', label: 'Projects Completed' },
  { value: '10+', label: 'Years Experience' },
  { value: '100%', label: 'Client Satisfaction' },
  { value: '24/7', label: 'Support Available' },
];

const projects = [
  {
    title: 'Kericho Water Supply Project',
    category: 'Borehole Services',
    description: 'Complete borehole drilling and equipping for a residential estate serving 200+ households.',
    image: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&h=400&fit=crop',
  },
  {
    title: 'Nakuru Solar Installation',
    category: 'Solar Installations',
    description: '50kW solar system installation for a commercial complex, reducing energy costs by 60%.',
    image: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?w=600&h=400&fit=crop',
  },
  {
    title: 'Eldoret Electrical Works',
    category: 'Electrical Works',
    description: 'Full electrical installation for a 5-story commercial building including backup generators.',
    image: 'https://images.unsplash.com/photo-1621905252507-b35492cc74b4?w=600&h=400&fit=crop',
  },
];

const testimonials = [
  {
    name: 'James Mwangi',
    role: 'Property Developer',
    text: 'Essence Engineering delivered exceptional quality on our borehole project. Their professionalism and expertise are unmatched in the industry.',
  },
  {
    name: 'Sarah Ochieng',
    role: 'Business Owner',
    text: 'The solar installation they did for our hotel has significantly reduced our energy costs. Highly recommend their services.',
  },
  {
    name: 'Peter Kiprop',
    role: 'Farm Manager',
    text: 'Reliable, professional, and efficient. They handled our entire water system upgrade seamlessly.',
  },
];
---

<Layout title="Essence Engineering | Powering Life. Delivering Excellence." description="Kenya's trusted partner for borehole services, electrical works, plumbing, solar installations, and engineering consultancy.">
  <Header />

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-dark)] via-[var(--color-primary-dark)] to-[var(--color-darker)]"></div>
    <!-- Decorative Elements -->
    <div class="absolute top-20 right-10 w-72 h-72 bg-[var(--color-secondary)] rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-pulse-glow"></div>
    <div class="absolute bottom-20 left-10 w-96 h-96 bg-[var(--color-accent)] rounded-full mix-blend-multiply filter blur-[128px] opacity-10 animate-pulse-glow" style="animation-delay: 1.5s"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 grid lg:grid-cols-2 gap-16 items-center">
      <div class="animate-slide-up">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[var(--color-secondary)]/30 bg-[var(--color-secondary)]/10 mb-6">
          <span class="w-2 h-2 bg-[var(--color-accent)] rounded-full animate-pulse"></span>
          <span class="text-sm text-[var(--color-secondary)]">Trusted Engineering Partner</span>
        </div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6">
          Powering Life.<br/>
          <span class="gradient-text">Delivering Excellence.</span>
        </h1>
        <p class="text-xl text-[var(--color-text-muted)] mb-8 max-w-lg">
          Kenya's premier engineering company for borehole services, electrical works, plumbing, solar installations, and general consultancy.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary">
            Get a Quote
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="/services" class="btn-secondary">Our Services</a>
        </div>
      </div>
      <div class="relative animate-float hidden lg:block">
        <div class="glass-card p-8 rounded-2xl">
          <div class="grid grid-cols-2 gap-6">
            {services.slice(0, 4).map((service) => (
              <div class="flex items-center gap-3">
                <div class="text-[var(--color-secondary)]" set:html={service.icon}></div>
                <span class="text-sm font-medium">{service.title}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-16 border-y border-[var(--color-border)] bg-[var(--color-dark)]/50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold gradient-text mb-2">{stat.value}</div>
            <div class="text-[var(--color-text-muted)]">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Our <span class="gradient-text">Services</span></h2>
        <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Comprehensive engineering solutions tailored to meet your needs.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="glass-card p-8 group cursor-pointer">
            <div class="w-16 h-16 rounded-xl bg-[var(--color-secondary)]/10 flex items-center justify-center text-[var(--color-secondary)] mb-6 group-hover:bg-[var(--color-secondary)] group-hover:text-white transition-all duration-300" set:html={service.icon}></div>
            <h3 class="text-xl font-bold mb-3">{service.title}</h3>
            <p class="text-[var(--color-text-muted)] leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="py-24 bg-[var(--color-dark)]">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Engineering <span class="gradient-text">Excellence</span> Since 2015</h2>
        <p class="text-[var(--color-text-muted)] text-lg mb-6 leading-relaxed">
          Essence Engineering Limited is a Kenyan company specializing in borehole services, electrical works, plumbing, construction, and solar installations. Founded by Kevin Terer, we are committed to delivering quality engineering solutions.
        </p>
        <p class="text-[var(--color-text-muted)] text-lg mb-8 leading-relaxed">
          Our team of licensed professionals brings expertise and dedication to every project, ensuring client satisfaction and long-term reliability.
        </p>
        <a href="/about" class="btn-primary">
          Learn More About Us
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-6">
        <div class="glass-card p-6 rounded-xl">
          <div class="text-[var(--color-secondary)] mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" /></svg>
          </div>
          <h3 class="font-bold mb-1">Licensed & Certified</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Fully registered with all relevant Kenyan authorities</p>
        </div>
        <div class="glass-card p-6 rounded-xl">
          <div class="text-[var(--color-accent)] mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
          </div>
          <h3 class="font-bold mb-1">Quality Guarantee</h3>
          <p class="text-sm text-[var(--color-text-muted)]">All work comes with comprehensive warranty</p>
        </div>
        <div class="glass-card p-6 rounded-xl">
          <div class="text-[var(--color-primary-light)] mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          </div>
          <h3 class="font-bold mb-1">24/7 Support</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Round-the-clock emergency support</p>
        </div>
        <div class="glass-card p-6 rounded-xl">
          <div class="text-[var(--color-secondary)] mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
          </div>
          <h3 class="font-bold mb-1">Expert Team</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Skilled professionals with years of experience</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Featured <span class="gradient-text">Projects</span></h2>
        <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">
          A showcase of our recent engineering projects across Kenya.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {projects.map((project) => (
          <div class="glass-card overflow-hidden group cursor-pointer">
            <div class="relative h-56 overflow-hidden">
              <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-dark)] to-transparent"></div>
              <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-[var(--color-secondary)]/90 text-sm font-medium">{project.category}</div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold mb-2">{project.title}</h3>
              <p class="text-[var(--color-text-muted)] text-sm">{project.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24 bg-[var(--color-dark)]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">What Clients <span class="gradient-text">Say</span></h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <div class="glass-card p-8">
            <div class="flex gap-1 mb-4">
              {[...Array(5)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" /></svg>
              ))}
            </div>
            <p class="text-[var(--color-text-muted)] mb-6 leading-relaxed">"{t.text}"</p>
            <div>
              <div class="font-bold">{t.name}</div>
              <div class="text-sm text-[var(--color-secondary)]">{t.role}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] opacity-90"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">Ready to Start Your Project?</h2>
      <p class="text-xl text-white/80 mb-8 max-w-2xl mx-auto">
        Contact us today for a free consultation and quote. Let's bring your engineering vision to life.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn-primary bg-white text-[var(--color-primary)] hover:bg-white/90">
          Get Free Quote
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
        <a href="tel:+254700000000" class="btn-secondary border-white text-white hover:bg-white hover:text-[var(--color-primary)]">
          Call Us Now
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
