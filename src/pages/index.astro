---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  { no: '01', title: 'Borehole Drilling & Water Works', desc: 'Site survey, drilling, pump installation and water quality testing for homes, farms and institutions.', href: '/services#boreholes' },
  { no: '02', title: 'Solar Installations', desc: 'Panel, inverter and battery systems that cut power bills for homes and businesses across Kenya.', href: '/services#solar' },
  { no: '03', title: 'Electrical Works', desc: 'Wiring, distribution and standby power — installed to code, tested, and handed over with documentation.', href: '/services#electrical' },
  { no: '04', title: 'Plumbing & Tank Structures', desc: 'Water supply, drainage, storage tanks and elevated structures, built to last in Kenyan conditions.', href: '/services#plumbing' },
];

const stats = [
  { value: '6', unit: '', label: 'Service lines' },
  { value: '24/7', unit: '', label: 'Emergency response for installed systems' },
  { value: '100%', unit: '', label: 'Systems tested before handover' },
  { value: '2026', unit: '', label: 'Registered in Kenya' },
];

const projects = [
  {
    no: 'P.01',
    title: 'Borehole supply for a residential estate',
    tag: 'Water works',
    img: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=900&q=70&auto=format&fit=crop',
  },
  {
    no: 'P.02',
    title: 'Commercial solar installation, Mombasa',
    tag: 'Solar',
    img: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?w=900&q=70&auto=format&fit=crop',
  },
  {
    no: 'P.03',
    title: 'Full electrical fit-out, Kisumu',
    tag: 'Electrical',
    img: 'https://images.unsplash.com/photo-1621905252507-b35492cc74b4?w=900&q=70&auto=format&fit=crop',
  },
];
---

<Layout title="Essence Engineering — Water, Power & Electrical Works in Kenya">
  <Header />

  <!-- ================= HERO ================= -->
  <section class="hero blueprint">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="mono-label mono-label--blue rise" style="--d:.05s">Boreholes · Solar · Electrical · Water works</p>
        <h1 class="display rise" style="--d:.14s">
          Water and power,<br />
          <span class="strong-blue">engineered to last.</span>
        </h1>
        <p class="lead rise" style="--d:.24s">
          Essence Engineering drills boreholes, installs solar and electrical systems, and builds water infrastructure — for homes, farms and businesses in Kenya.
        </p>
        <div class="hero-cta rise" style="--d:.34s">
          <a href="/contact" class="btn btn-blue">
            Request a free site visit
            <span class="btn-arrow">→</span>
          </a>
          <a href="/services" class="btn btn-ghost">What we do</a>
        </div>
      </div>

      <figure class="hero-fig rise" style="--d:.2s">
        <div class="frame zoom-frame hero-frame">
          <img
            src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1100&q=75&auto=format&fit=crop"
            alt="Solar panels installed on a roof"
            width="1100" height="1300"
            fetchpriority="high"
          />
        </div>
        <figcaption class="hero-cap mono-label">
          <span>Fig. 01 — Solar installation</span>
        </figcaption>
      </figure>
    </div>

    <!-- Title block -->
    <div class="wrap hero-titleblock">
      <span class="mono-label">Essence Engineering Limited</span>
      <span class="mono-label">General supplies · Construction · Consultancy</span>
      <span class="mono-label">Serving clients across Kenya</span>
    </div>
  </section>

  <!-- ================= SERVICES INDEX ================= -->
  <section class="section" data-reveal>
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="kicker mono-label">01 — Capabilities</p>
          <h2 class="h2">Everything your property needs,<br />from one contractor.</h2>
        </div>
        <p class="sec-head__aside">
          One point of contact from survey to commissioning, with warranties on installed systems and aftercare that responds.
        </p>
      </div>

      <div>
        {services.map((s) => (
          <a class="spec-row" href={s.href}>
            <span class="spec-row__no">{s.no}</span>
            <span>
              <span class="h3" style="display:block;margin-bottom:.375rem">{s.title}</span>
              <span style="color:var(--ink-2);font-size:.9375rem">{s.desc}</span>
            </span>
            <span class="spec-row__arrow">→</span>
          </a>
        ))}
      </div>

      <p style="margin-top:1.5rem">
        <a href="/services" class="link-line">See all six service lines &amp; process →</a>
      </p>
    </div>
  </section>

  <!-- ================= STATS (spec row) ================= -->
  <section class="section" style="padding-block:clamp(3rem,6vw,5rem)" data-reveal>
    <div class="wrap">
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat__value">{s.value}<span style="font-size:.5em;color:var(--ink-3)">{s.unit}</span></div>
            <p class="mono-label" style="margin:0.5rem 0 0">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= SELECTED WORK ================= -->
  <section class="section" style="background:var(--surface);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="kicker mono-label">02 — Selected work</p>
          <h2 class="h2">Recent jobs, on the record.</h2>
        </div>
        <a href="/projects" class="sec-head__aside sec-head__link link-line" style="align-self:end">All projects →</a>
      </div>

      <div class="work-grid">
        {projects.map((p, i) => (
          <a href="/projects" class="work-item" data-reveal style={`--rd:${i * 90}ms`}>
            <span class="frame zoom-frame work-frame">
              <img src={p.img} alt={p.title} width="900" height="620" loading="lazy" />
            </span>
            <span class="work-meta mono-label" style="margin-top:1rem">
              <span class="strong-blue">{p.no}</span> — {p.tag}
            </span>
            <span class="h3" style="display:block;margin-top:.375rem">{p.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHY US ================= -->
  <section class="section" data-reveal>
    <div class="wrap why-grid">
      <div>
        <p class="kicker mono-label">03 — Why Essence</p>
        <h2 class="h2">Simple, done well,<br />and we stand behind it.</h2>
      </div>
      <ul class="why-list">
        <li class="spec-row" style="grid-template-columns:minmax(3rem,auto) 1fr">
          <span class="spec-row__no">A</span>
          <span>
            <span class="h3" style="display:block;margin-bottom:.25rem">Survey before you spend</span>
            <span style="color:var(--ink-2);font-size:.9375rem">We look at the site and agree the scope before any work begins.</span>
          </span>
        </li>
        <li class="spec-row" style="grid-template-columns:minmax(3rem,auto) 1fr">
          <span class="spec-row__no">B</span>
          <span>
            <span class="h3" style="display:block;margin-bottom:.25rem">Built to standard</span>
            <span style="color:var(--ink-2);font-size:.9375rem">Correct materials, correct method, tested before handover.</span>
          </span>
        </li>
        <li class="spec-row" style="grid-template-columns:minmax(3rem,auto) 1fr">
          <span class="spec-row__no">C</span>
          <span>
            <span class="h3" style="display:block;margin-bottom:.25rem">We stay reachable</span>
            <span style="color:var(--ink-2);font-size:.9375rem">After handover, our number still works. Warranties honoured, call-outs answered.</span>
          </span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="cta" style="background:var(--dark);color:var(--on-dark)">
    <div class="wrap cta-inner">
      <div>
        <p class="mono-label mono-label--dark" style="margin-bottom:1.25rem">Talk to us</p>
        <h2 class="h2" style="color:var(--on-dark)">Have a water or power problem?<br />Let's walk the site.</h2>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-darkband">Request a free site visit <span class="btn-arrow">→</span></a>
        <a href="tel:254799240047" class="btn cta-tel">Call +254 799 240 047</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ---- hero ---- */
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-top: clamp(3.5rem, 9vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }

  .hero-copy .lead {
    margin: 1.75rem 0 2.25rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero-fig {
    margin: 0;
  }

  .hero-frame {
    aspect-ratio: 4 / 4.7;
    display: block;
    max-height: 560px;
  }

  .hero-cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    padding-inline: 0.25rem;
  }

  .hero-titleblock {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    border-top: 1px solid var(--line);
    padding-block: 0.875rem;
  }

  @media (min-width: 980px) {
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* ---- section heads ---- */
  .sec-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .sec-head__aside {
    color: var(--ink-2);
    max-width: 44ch;
    margin: 0;
    font-size: 1.0625rem;
  }

  @media (min-width: 860px) {
    .sec-head {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }
    .sec-head__aside { justify-self: end; }
  }

  /* ---- stats ---- */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
  }

  @media (min-width: 860px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ---- work ---- */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .work-item {
    text-decoration: none;
    display: block;
  }

  .work-frame {
    aspect-ratio: 16 / 10;
    display: block;
    overflow: hidden;
  }

  .work-meta {
    display: flex;
    gap: 0.5rem;
  }

  @media (min-width: 860px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  /* ---- why ---- */
  .why-grid {
    display: grid;
    gap: 2.5rem;
  }

  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 860px) {
    .why-grid { grid-template-columns: 1fr 1.4fr; gap: 4rem; }
  }

  /* ---- cta ---- */
  .cta-inner {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .cta-tel {
    border-color: var(--on-dark-line);
    color: var(--on-dark);
    background: transparent;
  }

  .cta-tel:hover {
    border-color: var(--on-dark);
  }

  @media (min-width: 860px) {
    .cta-inner {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
    }
    .cta-actions {
      justify-content: flex-end;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
