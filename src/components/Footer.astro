---
const currentYear = new Date().getFullYear();

const serviceLinks = [
  { label: 'Borehole Services', href: '/services' },
  { label: 'Electrical Works', href: '/services' },
  { label: 'Plumbing & Water Works', href: '/services' },
  { label: 'Solar Installations', href: '/services' },
  { label: 'Tank Structures', href: '/services' },
  { label: 'Engineering Consultancy', href: '/services' },
];

const companyLinks = [
  { label: 'About the company', href: '/about' },
  { label: 'Selected projects', href: '/projects' },
  { label: 'Request a quote', href: '/contact' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Essence Engineering — home">
          <span class="brand__mark" aria-hidden="true">E</span>
          <span class="brand__text">
            <span class="brand__name">Essence Engineering</span>
            <span class="brand__sub">Registered in Kenya</span>
          </span>
        </a>
        <p class="footer-tag">
          Borehole drilling, solar, electrical and water works — engineered and built in Kenya.
        </p>
        <p class="mono-label mono-label--dark" style="margin-top:1.5rem">Registered Kenyan company — serving the South Rift &amp; beyond</p>
      </div>

      <!-- Services -->
      <nav aria-label="Services">
        <h2 class="mono-label mono-label--dark">Services</h2>
        <ul class="footer-list">
          {serviceLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Company -->
      <nav aria-label="Company">
        <h2 class="mono-label mono-label--dark">Company</h2>
        <ul class="footer-list">
          {companyLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h2 class="mono-label mono-label--dark">Contact</h2>
        <ul class="footer-list footer-contact">
          <li><a href="tel:+254715377017" class="footer-link">+254 715 377 017</a></li>
          <li><a href="mailto:info@essenceengineering.co.ke" class="footer-link">info@essenceengineering.co.ke</a></li>
        </ul>
      </div>
    </div>

    <!-- Title block -->
    <div class="footer-titleblock">
      <span class="mono-label mono-label--dark">Essence Engineering Ltd</span>
      <span class="mono-label mono-label--dark">General supplies · Consultancy · Construction · Electrical &amp; water works</span>
      <span class="mono-label mono-label--dark">© {currentYear}</span>
    </div>

    <!-- Giant wordmark -->
    <div class="footer-wordmark" aria-hidden="true">Essence&nbsp;Engineering</div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--on-dark);
    padding-top: clamp(4rem, 8vw, 6.5rem);
    overflow: hidden;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 3px;
    background: var(--blue);
    color: var(--on-blue);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__name {
    font-weight: 800;
    font-size: 1rem;
    color: var(--on-dark);
  }

  .brand__sub {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7fa3e8;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--on-dark-line);
  }

  .footer-tag {
    color: var(--on-dark-2);
    max-width: 34ch;
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
  }

  .footer-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .footer-link {
    color: var(--on-dark-2);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--t-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--on-dark);
  }

  .footer-contact {
    color: var(--on-dark-2);
    font-size: 0.9375rem;
  }

  .footer-titleblock {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--on-dark-line);
  }

  .footer-wordmark {
    font-weight: 900;
    font-size: clamp(2.75rem, 9.5vw, 9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(237, 241, 246, 0.16);
    padding-block: 0.5rem 0;
    transform: translateY(0.35em);
    user-select: none;
  }

  @media (min-width: 700px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    }
  }
</style>
